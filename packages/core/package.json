{
  "name": "qompick-core",
  "version": "1.0.0",
  "description": "MapLibre location picker core (vanilla TS)",
  "type": "module",
  "main": "./dist/qompick-core.cjs",
  "module": "./dist/qompick-core.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/qompick-core.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/qompick-core.js",
      "require": "./dist/qompick-core.cjs"
    },
    "./styles.css": "./dist/qompick-core.css"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.10.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "maplibre-gl": "^6.10.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
