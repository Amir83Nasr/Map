{
  "name": "map",
  "private": true,
  "version": "1.0.0",
  "description": "Vanilla TypeScript map location picker (Qom)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
