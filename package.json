{
  "name": "qompick",
  "private": true,
  "version": "1.0.2",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter qompick-demo dev",
    "build": "pnpm --filter qompick-react build && pnpm --filter qompick-demo build",
    "typecheck": "pnpm --filter qompick-react build && pnpm --filter qompick-react typecheck && pnpm --filter qompick-demo exec tsc --noEmit",
    "lint": "eslint packages demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter qompick-react test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.20.0"
  }
}
