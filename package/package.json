{
  "name": "@amir83nasr/map",
  "version": "1.1.0",
  "description": "React location picker on MapLibre (Persian RTL, mobile-first, vector tiles)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir83Nasr/Map.git",
    "directory": "package"
  },
  "homepage": "https://amir83nasr.github.io/Map/",
  "bugs": {
    "url": "https://github.com/Amir83Nasr/Map/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "files": [
    "dist",
    "fonts"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.10.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "maplibre-gl": "^6.10.0",
    "react": "^18.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
