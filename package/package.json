{
  "name": "qompick-react",
  "version": "1.0.3",
  "description": "React location picker on MapLibre (Persian RTL, mobile-first, vector tiles)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amir83Nasr/Map",
    "directory": "packages/react"
  },
  "homepage": "https://amir83nasr.github.io/Map/",
  "bugs": {
    "url": "https://github.com/Amir83Nasr/Map/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
