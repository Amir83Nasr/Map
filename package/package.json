    "./package.json": "./package.json"
  },
  "main": "./dist/qompick-react.cjs",
  "module": "./dist/qompick-react.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/qompick-react.css",
  "files": [
    "dist",
    "fonts"
  ],
  "peerDependencies": {
    "maplibre-gl": "^6.10.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "maplibre-gl": "^6.10.0",
    "react": "^18.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
